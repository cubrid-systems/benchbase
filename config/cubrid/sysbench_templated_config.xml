<?xml version="1.0"?>
<parameters>
    <!-- A sysbench OLTP clone driven through TemplatedBenchmark.

         Templated benchmarks do not load, so the schema and its rows must exist
         before this runs:

           CREATE TABLE sbtest1 (
             id  INT PRIMARY KEY,
             k   INT NOT NULL DEFAULT 0,
             c   VARCHAR(120) NOT NULL DEFAULT '',
             pad VARCHAR(60)  NOT NULL DEFAULT ''
           );
           CREATE INDEX k_1 ON sbtest1 (k);

         populated with ids 1..100000. The ranges in sysbench_templates.xml are
         written against exactly that, so changing the row count means changing
         them too. -->
    <type>CUBRID</type>
    <driver>cubrid.jdbc.driver.CUBRIDDriver</driver>
    <url>jdbc:cubrid:localhost:35000:sbench:::</url>
    <username>dba</username>
    <password></password>
    <reconnectOnConnectionFailure>true</reconnectOnConnectionFailure>
    <isolation>TRANSACTION_READ_COMMITTED</isolation>
    <batchsize>128</batchsize>

    <query_templates_file>config/cubrid/sysbench_templates.xml</query_templates_file>

    <terminals>8</terminals>
    <works>
        <work>
            <time>30</time>
            <rate>unlimited</rate>
            <weights>60,10,10,10,10</weights>
        </work>
    </works>

    <transactiontypes>
        <transactiontype><name>PointSelect</name></transactiontype>
        <transactiontype><name>UpdateIndex</name></transactiontype>
        <transactiontype><name>UpdateNonIndex</name></transactiontype>
        <transactiontype><name>Insert</name></transactiontype>
        <transactiontype><name>Delete</name></transactiontype>
    </transactiontypes>
</parameters>
